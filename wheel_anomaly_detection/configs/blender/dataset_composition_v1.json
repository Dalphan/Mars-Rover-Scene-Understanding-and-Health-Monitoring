{
  "schema_version": 1,
  "dataset_id": "curiosity_wheel_hole_v1_10000",
  "master_seed": 20260810,
  "source_contracts": {
    "domain_randomization": "configs/blender/domain_randomization_dataset_v1.json",
    "hole_anomaly": "configs/blender/wheel_hole_anomaly_dataset_v1.json"
  },
  "output_root": "outputs/anomaly_detection_2/datasets",
  "pool": {
    "manifest": "pool/manifest.jsonl",
    "standalone_clean_units": 7500,
    "paired_clean_hole_units": 1250,
    "artifact_policy": "reference_relative_paths_without_copy"
  },
  "composition": {
    "total_images": 10000,
    "clean_images": 8750,
    "anomaly_images": 1250,
    "hole": {
      "severity": {"small": 0.50, "medium": 0.40, "large": 0.10},
      "surface": {"tread": 0.80, "shoulder": 0.20},
      "constraints": {"large_surface": "tread"}
    },
    "domain_randomization": {
      "camera_pose": {
        "A_overhead": 0.40,
        "C_leading_three_quarter": 0.275,
        "C_trailing_three_quarter": 0.275,
        "D_upper_detail": 0.05
      },
      "lighting": {"mars_dusty_refined": 0.75, "mars_clear_refined": 0.25},
      "surface_wear": {"surface_current": 0.20, "wear_light": 0.45, "wear_evident": 0.35},
      "target_wheel": "uniform_six",
      "healthy_roll": "uniform_eight_phases"
    }
  },
  "splits": {
    "train": {"fraction": 0.70, "image_count": 7000, "standalone_clean_units": 7000, "paired_clean_hole_units": 0},
    "validation": {"fraction": 0.10, "image_count": 1000, "standalone_clean_units": 500, "paired_clean_hole_units": 250},
    "test": {"fraction": 0.20, "image_count": 2000, "standalone_clean_units": 0, "paired_clean_hole_units": 1000}
  },
  "evaluation_minimum_quotas": {
    "validation": {"wheel_camera_severity": 1, "wheel_camera_sector": 1, "wheel_camera_surface": 1},
    "test": {"wheel_camera_severity": 2, "wheel_camera_sector": 2, "wheel_camera_surface": 2}
  },
  "evaluation_categories": {
    "target_wheel": ["wheel_front_left", "wheel_front_right", "wheel_middle_left", "wheel_middle_right", "wheel_rear_left", "wheel_rear_right"],
    "camera_pose": ["A_overhead", "C_leading_three_quarter", "C_trailing_three_quarter", "D_upper_detail"],
    "severity": ["small", "medium", "large"],
    "image_sector": ["leading", "upper", "trailing"],
    "surface": ["tread", "shoulder"]
  },
  "split_policy": {
    "train_clean_only": true,
    "pair_lock_indivisible": true,
    "artifact_materialization": "index_only",
    "selection": "deterministic_quota_aware",
    "split_order": ["train", "validation", "test"]
  }
}
